# Copia este archivo como .env solo si quieres cambiar algún valor.
# Sin .env, la aplicación usa estos mismos valores por defecto.
# Este proyecto no necesita secretos: no añadas contraseñas ni claves aquí.

# Ruta de la base de datos SQLite (relativa a la raíz del repositorio o absoluta).
DB_PATH=data/processed/athletaguard.db

# Ruta del modelo entrenado (relativa a la raíz del repositorio o absoluta).
MODEL_PATH=models/modelo.joblib

# Puerto del servidor web.
PORT=8000
